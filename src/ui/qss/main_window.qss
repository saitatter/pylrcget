QWidget#TopBar {
    background: transparent;
}

QWidget#TopBarGroup {
    background: {{color-bg-panel}};
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-lg}};
}

QWidget#TopBarGroup:hover {
    border-color: {{color-border}};
}

QWidget#TopBarGroup {
    min-height: 72px;
}

QLabel#TopBarLabel {
    color: {{color-text-muted}};
    font-size: {{font-size-xs}};
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
}

QLineEdit#TopBarSearch {
    background: {{color-bg-app}};
    border-color: {{color-border}};
}

QLineEdit#TopBarSearch:focus {
    border-color: {{color-accent}};
}

QToolButton#TopBarAction {
    min-width: 36px;
    min-height: 36px;
}

QToolButton#TopBarAction[actionState="loading"] {
    background: {{color-bg-pressed}};
    border-color: {{color-accent}};
    color: {{color-accent}};
}

QToolButton#TopBarAction[actionState="success"] {
    background: {{color-success-bg}};
    border-color: {{color-success-border}};
    color: {{color-success-text}};
}

QToolButton#TopBarAction[actionState="error"] {
    background: {{color-error-bg}};
    border-color: {{color-error-border}};
    color: {{color-error-text}};
}

QToolButton#TopBarAction:checked {
    background: {{color-bg-control}};
    border-color: {{color-accent}};
    color: {{color-accent}};
}

QWidget#ScanRow {
    background: {{color-bg-app}};
    border-top: 1px solid {{color-border-strong}};
}

QWidget#LibraryNavBar {
    background: {{color-bg-panel}};
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-lg}};
}

QToolButton#LibraryNavButton {
    min-width: 32px;
    min-height: 32px;
}

QToolButton#LibraryBreadcrumbButton {
    border: none;
    background: transparent;
    color: {{color-text-soft}};
    padding: 4px 6px;
}

QToolButton#LibraryBreadcrumbButton:hover:enabled {
    color: {{color-accent}};
    background: {{color-bg-control}};
    border-radius: {{radius-sm}};
}

QToolButton#LibraryBreadcrumbButton:disabled {
    color: {{color-text}};
    font-weight: 600;
}

QLabel#LibraryBreadcrumbSeparator {
    color: {{color-text-muted}};
    padding: 0 2px;
}

QLabel#ScanLabel {
    color: {{color-text-soft}};
    font-size: {{font-size-sm}};
}

QLabel#ScanDetails {
    color: {{color-text-muted}};
    font-size: {{font-size-sm}};
}

QProgressBar#ScanProgress {
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-pill}};
    height: 10px;
}

QPushButton#ScanCancelButton {
    min-width: 96px;
}

QProgressBar#ScanProgress::chunk {
    border-radius: 999px;
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 {{color-slider-fill-start}}, stop: 1 {{color-slider-fill-end}}
    );
}

QWidget#LogPanel {
    background: {{color-bg-panel}};
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-lg}};
}

QLabel#LogPanelTitle {
    color: {{color-text-strong}};
    font-size: {{font-size-sm}};
    font-weight: 600;
}

QComboBox#LogPanelFilter {
    min-width: 96px;
}

QPushButton#LogPanelCopy,
QPushButton#LogPanelSave,
QPushButton#LogPanelOpenFolder,
QPushButton#LogPanelClear {
    min-width: 84px;
}

QPlainTextEdit#LogPanelOutput {
    background: {{color-bg-app}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    color: {{color-text}};
    selection-background-color: {{color-selection-bg}};
    selection-color: {{color-selection-text}};
    font-family: Consolas, "Cascadia Mono", "Segoe UI Mono", monospace;
    font-size: {{font-size-sm}};
}

QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 8px;
    border-radius: 10px;
}

QToolButton:hover {
    background: {{color-bg-control}};
    border-color: {{color-border}};
}

QToolButton:pressed {
    background: {{color-bg-pressed}};
}
