QFrame#Toast {
    background: {{bg}};
    border: 1px solid {{border}};
    border-radius: 14px;
}

QLabel {
    color: {{text}};
    font-size: 12px;
}

QToolButton {
    border: none;
    background: transparent;
    color: {{text}};
    padding: 4px 8px;
}

QToolButton:hover {
    background: {{hover_bg}};
    border-radius: 8px;
}
