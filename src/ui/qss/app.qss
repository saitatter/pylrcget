QWidget {
    background-color: #020617;
    color: #e5e7eb;
}

QMainWindow, QMenuBar, QStatusBar, QSplitter::handle {
    background-color: #020617;
}

QLineEdit, QTextEdit, QPlainTextEdit, QTableWidget, QAbstractItemView, QComboBox, QMenu, QMessageBox, QProgressBar {
    background-color: #0b1222;
    color: #e5e7eb;
    border: 1px solid #1f2937;
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    border-radius: 10px;
    padding: 8px;
    selection-background-color: #38bdf8;
    selection-color: #020617;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border-color: #38bdf8;
}

QPushButton {
    background-color: #0b1222;
    color: #e5e7eb;
    border: 1px solid #1f2937;
    border-radius: 10px;
    padding: 8px 12px;
}

QPushButton:hover {
    border-color: #38bdf8;
    background-color: #111827;
}

QPushButton[actionState="loading"] {
    background-color: #0f172a;
    border-color: #38bdf8;
    color: #e0f2fe;
}

QPushButton[actionState="success"] {
    background-color: #052e1a;
    border-color: #16a34a;
    color: #dcfce7;
}

QPushButton[actionState="error"] {
    background-color: #2a0a0a;
    border-color: #ef4444;
    color: #fee2e2;
}

QPushButton:pressed {
    background-color: #0f172a;
}

QPushButton:disabled, QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    color: #6b7280;
}

QCheckBox {
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #334155;
    background: #0b1222;
}

QCheckBox::indicator:checked {
    background: #38bdf8;
    border-color: #38bdf8;
}

QTabWidget#MainTabs::pane {
    border: 1px solid #111827;
    border-radius: 16px;
    margin-top: 12px;
    background: #040b19;
}

QTabWidget#MainTabs QTabBar {
    left: 10px;
}

QTabWidget#MainTabs QTabBar::tab {
    background: #08101f;
    color: #94a3b8;
    border: 1px solid #111827;
    border-radius: 14px;
    padding: 10px 16px;
    margin-right: 8px;
    min-width: 92px;
    font-weight: 600;
}

QTabWidget#MainTabs QTabBar::tab:hover {
    color: #e2e8f0;
    border-color: #1f2937;
    background: #0b1222;
}

QTabWidget#MainTabs QTabBar::tab:selected {
    background: #111827;
    color: #f8fafc;
    border-color: #38bdf8;
}

QTabWidget#MainTabs QTabBar::tab:!selected {
    margin-top: 4px;
}

QMenu {
    padding: 8px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: #111827;
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: #020617;
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: #1f2937;
    border-radius: 6px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: #38bdf8;
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
}
