QWidget {
    background-color: {{color-bg-app}};
    color: {{color-text}};
    font-family: {{font-family-base}};
}

QMainWindow, QMenuBar, QStatusBar, QSplitter::handle {
    background-color: {{color-bg-app}};
}

QLineEdit, QTextEdit, QPlainTextEdit, QTableWidget, QAbstractItemView, QComboBox, QMenu, QMessageBox, QProgressBar {
    background-color: {{color-bg-control}};
    color: {{color-text}};
    border: 1px solid {{color-border}};
}

QLineEdit, QTextEdit, QPlainTextEdit, QComboBox {
    background-color: {{color-bg-panel}};
    border-radius: {{radius-md}};
    padding: {{space-2}};
    selection-background-color: {{color-accent}};
    selection-color: {{color-bg-app}};
}

QLineEdit, QComboBox, QPushButton {
    min-height: 38px;
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus {
    border-color: {{color-accent}};
}

QLineEdit:hover, QTextEdit:hover, QPlainTextEdit:hover, QComboBox:hover {
    border-color: {{color-border-hover}};
}

QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus, QComboBox:focus,
QPushButton:focus, QToolButton:focus {
    outline: none;
    border-color: {{color-accent}};
}

QPushButton:focus, QToolButton:focus {
    background: {{color-bg-elevated}};
}

QPushButton {
    background-color: {{color-bg-control}};
    color: {{color-text}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    padding: {{space-2}} {{space-3}};
}

QPushButton:hover {
    border-color: {{color-accent}};
    background-color: {{color-bg-elevated}};
}

QPushButton[actionState="loading"] {
    background-color: {{color-bg-pressed}};
    border-color: {{color-accent}};
    color: {{color-text-strong}};
}

QPushButton[actionState="success"] {
    background-color: {{color-success-bg}};
    border-color: {{color-success-border}};
    color: {{color-success-text}};
}

QPushButton[actionState="error"] {
    background-color: {{color-error-bg}};
    border-color: {{color-error-border}};
    color: {{color-error-text}};
}

QPushButton:pressed {
    background-color: {{color-bg-pressed}};
}

QPushButton:disabled, QLineEdit:disabled, QTextEdit:disabled, QComboBox:disabled {
    color: {{color-disabled-text}};
    border-color: {{color-disabled-border}};
    background: {{color-disabled-bg}};
}

QCheckBox {
    spacing: 8px;
    color: {{color-text}};
    min-height: 20px;
    padding: 2px 0;
}

QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border-radius: 5px;
    border: 1px solid {{color-border}};
    background: {{color-bg-control}};
}

QCheckBox::indicator:unchecked {
    background: {{color-bg-control}};
    border-color: {{color-border}};
}

QCheckBox::indicator:checked {
    background: {{color-accent}};
    border-color: {{color-accent}};
    image: url("{{asset-url}}/assets/icons/check.svg");
}

QCheckBox::indicator:hover {
    border-color: {{color-accent}};
    background: {{color-bg-elevated}};
}

QCheckBox::indicator:pressed {
    background: {{color-bg-pressed}};
}

QCheckBox::indicator:focus {
    border-color: {{color-accent}};
    background: {{color-bg-elevated}};
}

QCheckBox:disabled {
    color: {{color-disabled-text}};
}

QCheckBox::indicator:disabled {
    background: {{color-disabled-bg}};
    border-color: {{color-disabled-border}};
}

QCheckBox::indicator:checked:disabled {
    background: {{color-disabled-border}};
    border-color: {{color-disabled-border}};
}

QComboBox {
    padding-right: 32px;
}

QComboBox::drop-down {
    border: none;
    width: 28px;
}

QComboBox QAbstractItemView {
    border-radius: {{radius-md}};
    padding: 4px;
    outline: 0;
}

QLabel#OnboardingTitle {
    font-size: {{font-size-lg}};
    font-weight: 700;
    color: {{color-text-strong}};
}

QLabel#OnboardingBody,
QLabel#OnboardingSteps {
    color: {{color-text}};
}

QLabel#SettingsValidationHint {
    border-radius: {{radius-md}};
    padding: 6px {{space-3}};
    background: {{color-validation-bg}};
    color: {{color-text}};
    border: 1px solid {{color-validation-border}};
}

QLabel#SettingsValidationHint[validationState="error"] {
    background: {{color-error-bg}};
    color: {{color-error-text}};
    border-color: {{color-error-border}};
}

QLabel#SettingsValidationHint[validationState="success"] {
    background: {{color-success-bg}};
    color: {{color-success-text}};
    border-color: {{color-success-border}};
}

QTabWidget#MainTabs::pane {
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-xl}};
    margin-top: 12px;
    background: {{color-bg-panel}};
}

QTabWidget#MainTabs QTabBar {
    left: 10px;
}

QTabWidget#MainTabs QTabBar::tab {
    background: {{color-bg-panel}};
    color: {{color-text-muted}};
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-lg}};
    padding: 10px {{space-4}};
    margin-right: 8px;
    min-width: 92px;
    font-weight: 600;
}

QTabWidget#MainTabs QTabBar::tab:hover {
    color: {{color-text}};
    border-color: {{color-border}};
    background: {{color-bg-control}};
}

QTabWidget#MainTabs QTabBar::tab:selected {
    background: {{color-bg-elevated}};
    color: {{color-text-strong}};
    border-color: {{color-accent}};
}

QTabWidget#MainTabs QTabBar::tab:focus {
    border-color: {{color-accent}};
    color: {{color-text-strong}};
}

QTabWidget#MainTabs QTabBar::tab:!selected {
    margin-top: 4px;
}

QMenu {
    padding: 8px;
}

QMenu::item {
    padding: 8px 16px;
    border-radius: 8px;
}

QMenu::item:selected {
    background: {{color-menu-hover}};
}

QMenu QWidget#ContextMenuSection {
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    margin: 2px 0;
}

QMenu QLabel#ContextMenuSectionTitle {
    color: {{color-accent}};
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.12em;
}

QMenu QLabel#ContextMenuSectionDetail {
    color: {{color-text-muted}};
    font-size: {{font-size-sm}};
}

QScrollBar:vertical, QScrollBar:horizontal {
    background: {{color-scrollbar-track}};
    border: none;
    margin: 0px;
}

QScrollBar::handle:vertical, QScrollBar::handle:horizontal {
    background: {{color-scrollbar-handle}};
    border-radius: 6px;
    min-height: 24px;
    min-width: 24px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: {{color-scrollbar-hover}};
}

QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
    border: none;
}
