QWidget#EmptyState {
    background: transparent;
}

QLabel#EmptyStateIcon {
    padding-bottom: 4px;
}

QLabel#EmptyStateTitle {
    color: {{color-empty-title}};
    font-size: 18px;
    font-weight: 650;
}

QLabel#EmptyStateBody {
    color: {{color-empty-body}};
    font-size: 12px;
    line-height: 1.4;
}

QPushButton#EmptyStateAction,
QPushButton#EmptyStateSecondaryAction,
QPushButton#EmptyStateTertiaryAction,
QPushButton#EmptyStateQuaternaryAction {
    margin-top: 8px;
    min-width: 140px;
    min-height: 40px;
}

QPushButton#EmptyStateAction {
    background: {{color-accent}};
    color: {{color-bg-app}};
    border: 1px solid {{color-accent}};
    font-weight: 650;
}

QPushButton#EmptyStateAction:hover {
    background: {{color-border-hover}};
    border-color: {{color-border-hover}};
}

QPushButton#EmptyStateSecondaryAction,
QPushButton#EmptyStateTertiaryAction,
QPushButton#EmptyStateQuaternaryAction {
    background: {{color-bg-control}};
    color: {{color-text}};
    border: 1px solid {{color-border}};
}

QPushButton#EmptyStateSecondaryAction:hover,
QPushButton#EmptyStateTertiaryAction:hover,
QPushButton#EmptyStateQuaternaryAction:hover {
    background: {{color-bg-elevated}};
    border-color: {{color-accent}};
}
