QWidget#EmptyState {
    background: transparent;
}

QLabel#EmptyStateIcon {
    padding-bottom: 4px;
}

QLabel#EmptyStateTitle {
    color: {{color-empty-title}};
    font-size: 18px;
    font-weight: 650;
}

QLabel#EmptyStateBody {
    color: {{color-empty-body}};
    font-size: 12px;
    line-height: 1.4;
}

QPushButton#EmptyStateAction,
QPushButton#EmptyStateSecondaryAction,
QPushButton#EmptyStateTertiaryAction,
QPushButton#EmptyStateQuaternaryAction {
    margin-top: 8px;
    min-width: 140px;
    min-height: 40px;
}
