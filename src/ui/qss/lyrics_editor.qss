QLabel#LyricsTitle {
    font-weight: 650;
    font-size: {{font-size-lg}};
}

QLabel#LyricsDirtyBadge,
QLabel#LyricsValidationBadge {
    min-height: 28px;
    max-height: 28px;
    padding: 0 10px;
    border-radius: {{radius-sm}};
    font-size: {{font-size-xs}};
    font-weight: 800;
}

QPushButton#LyricsDiscardDraft,
QPushButton#LyricsShowDiff,
QPushButton#LyricsClearTimestamps,
QPushButton#LyricsAutoSync {
    min-height: 28px;
    max-height: 28px;
    min-width: 44px;
    padding: 0 10px;
    border-radius: {{radius-sm}};
    font-size: {{font-size-xs}};
    font-weight: 650;
}

QLabel#LyricsDirtyBadge {
    background: {{color-warning-bg}};
    color: {{color-warning-text}};
    border: 1px solid {{color-warning-border}};
}

QLabel#LyricsValidationBadge {
    background: {{color-validation-bg}};
    color: {{color-text}};
    border: 1px solid {{color-validation-border}};
}

QLabel#LyricsValidationBadge[validationState="error"] {
    background: {{color-error-bg}};
    color: {{color-error-text}};
    border-color: {{color-error-border}};
}

QLabel#LyricsValidationBadge[validationState="success"] {
    background: {{color-success-bg}};
    color: {{color-success-text}};
    border-color: {{color-success-border}};
}

QPushButton#LyricsDiscardDraft {
    background: transparent;
    color: {{color-warning-text}};
    border: 1px solid {{color-warning-border}};
}

QPushButton#LyricsDiscardDraft:hover {
    background: {{color-warning-bg}};
}

QPushButton#LyricsShowDiff {
    background: transparent;
    color: {{color-accent}};
    border: 1px solid {{color-border}};
}

QPushButton#LyricsShowDiff:hover {
    background: {{color-bg-elevated}};
    border-color: {{color-accent}};
    color: {{color-text}};
}

QWidget#LyricsModeSelector {
    min-height: 28px;
    max-height: 28px;
    padding: 1px;
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-sm}};
}

QPushButton#LyricsModeButton {
    min-height: 24px;
    max-height: 24px;
    min-width: 52px;
    padding: 0 8px;
    background: transparent;
    color: {{color-text-muted}};
    border: none;
    border-radius: {{radius-sm}};
    font-size: {{font-size-xs}};
    font-weight: 650;
}

QPushButton#LyricsModeButton:hover {
    background: {{color-bg-elevated}};
    color: {{color-text}};
}

QPushButton#LyricsModeButton:checked {
    background: {{color-accent}};
    border-color: {{color-accent}};
    color: {{color-bg-app}};
}

QPushButton#LyricsClearTimestamps,
QPushButton#LyricsAutoSync {
    background: transparent;
    color: {{color-accent}};
    border: 1px solid {{color-accent}};
}

QPushButton#LyricsClearTimestamps:hover,
QPushButton#LyricsAutoSync:hover {
    background: {{color-accent}};
    color: {{color-bg-app}};
}

QPushButton#LyricsClearTimestamps:disabled,
QPushButton#LyricsAutoSync:disabled {
    color: {{color-disabled-text}};
    border-color: {{color-disabled-border}};
}

QPushButton#LyricsMoreActions {
    min-height: {{control-height-normal}};
    max-height: {{control-height-normal}};
    min-width: 64px;
    padding: {{space-2}} {{space-3}};
    background: {{color-bg-control}};
    color: {{color-text}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    font-size: {{font-size-sm}};
    font-weight: 600;
}

QPushButton#LyricsMoreActions:hover {
    background: {{color-bg-elevated}};
    border-color: {{color-accent}};
    color: {{color-text}};
}

QPushButton#LyricsMoreActions:pressed {
    background: {{color-bg-pressed}};
}

QPushButton#LyricsAutofix {
    background: {{color-warning-bg}};
    color: {{color-warning-text}};
    border: 1px solid {{color-warning-border}};
    border-radius: {{radius-md}};
}

QPushButton#LyricsAutofix:hover {
    background: {{color-bg-elevated}};
    border-color: {{color-accent}};
    color: {{color-text}};
}

QPushButton#LyricsAutofix:disabled {
    background: {{color-disabled-bg}};
    color: {{color-disabled-text}};
    border-color: {{color-disabled-border}};
}

QDoubleSpinBox#LyricsShiftSpin {
    min-height: {{control-height-normal}};
    padding: {{space-2}} {{space-3}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    background: {{color-bg-control}};
    color: {{color-text}};
    selection-background-color: {{color-accent}};
    selection-color: {{color-bg-app}};
}

QDoubleSpinBox#LyricsShiftSpin:hover {
    border-color: {{color-accent}};
    background: {{color-bg-elevated}};
}

QDoubleSpinBox#LyricsShiftSpin:focus {
    border-color: {{color-accent}};
    outline: none;
}

QDoubleSpinBox#LyricsShiftSpin:disabled {
    color: {{color-disabled-text}};
    border-color: {{color-disabled-border}};
    background: {{color-disabled-bg}};
}

QLabel#LyricsMessage {
    color: {{color-empty-body}};
}

QLabel#LyricsValidationHint {
    border-radius: {{radius-md}};
    padding: 6px {{space-3}};
    background: {{color-validation-bg}};
    color: {{color-text}};
    border: 1px solid {{color-validation-border}};
}

QLabel#LyricsValidationHint[validationState="error"] {
    background: {{color-error-bg}};
    color: {{color-error-text}};
    border-color: {{color-error-border}};
}

QLabel#LyricsValidationHint[validationState="success"] {
    background: {{color-success-bg}};
    color: {{color-success-text}};
    border-color: {{color-success-border}};
}
