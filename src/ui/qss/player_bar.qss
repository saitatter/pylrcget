QWidget#PlayerBar {
    background-color: {{color-bg-app}};
    border-top: 1px solid {{color-border}};
}

QWidget#PlayerShell {
    background: {{color-bg-elevated}};
    border: 1px solid {{color-border}};
    border-radius: 999px;
}

QWidget#PlayerBar[compact="true"] QWidget#PlayerShell {
    border-radius: 999px;
}

QWidget#PlayerBar[compact="true"] QWidget#PlayerExtras {
    min-width: 205px;
}

QWidget#PlayerMeta,
QWidget#PlayerCenter,
QWidget#PlayerExtras {
    background: transparent;
    border: none;
}

QWidget#PlayerMeta {
    padding-right: 4px;
}

QWidget#PlayerCenter {
    min-height: 66px;
    padding-left: 2px;
    padding-right: 2px;
}

QWidget#PlayerExtras {
    padding-left: 4px;
    padding-right: 4px;
}

QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 6px;
    border-radius: {{radius-md}};
    color: {{color-text}};
}

QToolButton:hover {
    background: {{color-bg-control}};
    border-color: {{color-border}};
    color: {{color-accent}};
}

QToolButton:pressed {
    background: {{color-bg-pressed}};
}

QToolButton:disabled {
    color: {{color-disabled-text}};
    border-color: {{color-disabled-border}};
    background: transparent;
}

QToolButton#BtnPlay {
    background: {{color-bg-elevated}};
    border: 1px solid {{color-border}};
    border-radius: 22px;
    padding: 0;
    min-width: 44px;
    min-height: 44px;
    max-width: 44px;
    max-height: 44px;
    color: {{color-text}};
}

QToolButton#BtnPlay:hover {
    border-color: {{color-accent}};
    background: {{color-bg-control}};
    color: {{color-accent}};
}

QToolButton#BtnPlay:pressed {
    background: {{color-bg-pressed}};
}

QToolButton#BtnPrev,
QToolButton#BtnNext {
    background: transparent;
    border: 1px solid transparent;
    padding: 0;
    min-width: 28px;
    min-height: 28px;
    max-width: 28px;
    max-height: 28px;
    border-radius: 14px;
}

QToolButton#BtnPrev:hover,
QToolButton#BtnNext:hover {
    background: {{color-bg-control}};
    border-color: {{color-accent}};
    color: {{color-accent}};
}

QToolButton#BtnPrev:pressed,
QToolButton#BtnNext:pressed {
    background: {{color-bg-pressed}};
}

QLabel {
    color: {{color-text-soft}};
    font-size: {{font-size-sm}};
    background: transparent;
    border: none;
    padding: 0;
}

QLabel#HotkeyHintBadge {
    background: {{color-accent}};
    color: {{color-bg-app}};
    border: 1px solid {{color-accent-alt}};
    border-radius: {{radius-pill}};
    padding: 1px 6px;
    font-size: {{font-size-xs}};
    font-weight: 800;
}

QLabel#NowPlaying {
    color: {{color-text-strong}};
    font-size: 15px;
    font-weight: 600;
    background: transparent;
}

QLabel#NowPlayingArtist {
    color: {{color-text}};
    font-size: 12px;
    background: transparent;
}

QLabel#NowPlayingAlbum {
    color: {{color-text-muted}};
    font-size: 12px;
    background: transparent;
}

QLabel#NowPlayingArtist,
QLabel#NowPlayingAlbum {
    text-decoration: none;
}

QLabel#NowPlayingArtist:hover,
QLabel#NowPlayingAlbum:hover {
    color: {{color-accent}};
}

QWidget#PlayerBar[compact="true"] QLabel#NowPlaying {
    font-size: 13px;
}

QWidget#PlayerBar[compact="true"] QLabel#NowPlayingArtist,
QWidget#PlayerBar[compact="true"] QLabel#NowPlayingAlbum {
    font-size: 10px;
}

QLabel#MetaLabel,
QLabel#TimeLabel {
    color: {{color-text}};
    font-size: 11px;
    font-weight: 500;
    background: transparent;
}

QWidget#PlayerExtras QLabel#MetaLabel {
    min-width: 40px;
}

QLabel#NowPlayingCover {
    background: {{color-bg-pressed}};
    border: 1px solid {{color-cover-border}};
    border-radius: 12px;
}

QSlider#PlayerSlider::groove:horizontal {
    height: 7px;
    background: {{color-bg-pressed}};
    border-radius: 999px;
    margin: 0;
}

QSlider#PlayerSlider::handle:horizontal {
    width: 12px;
    height: 12px;
    margin: -4px 0;
    border-radius: 7px;
    background: {{color-accent}};
    border: 2px solid {{color-slider-handle-border}};
}

QSlider#PlayerSlider::handle:horizontal:hover {
    background: {{color-accent-alt}};
}

QSlider#PlayerSlider::sub-page:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 {{color-slider-fill-start}},
        stop:1 {{color-slider-fill-end}}
    );
    border-radius: 999px;
}

QSlider#PlayerSlider::add-page:horizontal {
    background: {{color-bg-pressed}};
    border-radius: 999px;
}

QComboBox#SpeedCombo {
    background: {{color-bg-panel}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    padding: 2px 6px 3px 6px;
    color: {{color-text}};
    min-width: 100px;
    max-width: 100px;
    min-height: 28px;
    max-height: 28px;
    font-size: 11px;
}

QComboBox#SpeedCombo:hover {
    border-color: {{color-accent}};
}

QComboBox#SpeedCombo::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox#SpeedCombo::down-arrow {
    image: url("{{asset-url}}/assets/icons/chevron-down.svg");
    width: 10px;
    height: 10px;
    margin-right: 4px;
}

QToolButton#SpeedAdjustButton {
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    min-width: 26px;
    min-height: 26px;
    max-width: 26px;
    max-height: 26px;
    font-size: 12px;
    font-weight: 600;
    padding: 2px;
}

QToolButton#SpeedAdjustButton:hover {
    border-color: {{color-accent}};
    background: {{color-bg-elevated}};
    color: {{color-accent}};
}
