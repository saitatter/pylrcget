QWidget#PlayerBar {
    background-color: {{color-bg-app}};
    border-top: 1px solid {{color-border-strong}};
}

QWidget#PlayerShell {
    background: {{color-bg-panel}};
    border: 1px solid {{color-border-strong}};
    border-radius: {{radius-xl}};
}

QWidget#PlayerBar[compact="true"] QWidget#PlayerShell {
    border-radius: {{radius-lg}};
}

QWidget#PlayerBar[compact="true"] QWidget#PlayerExtras {
    min-width: 84px;
}

QWidget#PlayerMeta,
QWidget#PlayerCenter,
QWidget#PlayerExtras {
    background: transparent;
    border: none;
}

QWidget#PlayerCenter {
    min-height: 72px;
}

QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 6px;
    border-radius: {{radius-md}};
    color: {{color-text}};
}

QToolButton:hover {
    background: {{color-bg-control}};
    border-color: {{color-border}};
    color: {{color-accent}};
}

QToolButton:pressed {
    background: {{color-bg-pressed}};
}

QToolButton#BtnPlay {
    background: {{color-bg-elevated}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-pill}};
    padding: 14px;
    min-width: 54px;
    min-height: 54px;
    color: {{color-text}};
}

QToolButton#BtnPlay:hover {
    border-color: {{color-accent}};
    background: {{color-bg-control}};
    color: {{color-accent}};
}

QToolButton#BtnPlay:pressed {
    background: {{color-bg-pressed}};
}

QLabel {
    color: {{color-text-soft}};
    font-size: {{font-size-sm}};
}

QLabel#NowPlaying {
    color: {{color-text-strong}};
    font-size: {{font-size-lg}};
    font-weight: 600;
}

QLabel#NowPlayingArtist {
    color: {{color-text}};
    font-size: {{font-size-sm}};
}

QLabel#NowPlayingAlbum {
    color: {{color-text-muted}};
    font-size: {{font-size-sm}};
}

QLabel#NowPlayingArtist,
QLabel#NowPlayingAlbum {
    text-decoration: none;
}

QLabel#NowPlayingArtist:hover,
QLabel#NowPlayingAlbum:hover {
    color: {{color-accent}};
}

QWidget#PlayerBar[compact="true"] QLabel#NowPlaying {
    font-size: 13px;
}

QWidget#PlayerBar[compact="true"] QLabel#NowPlayingArtist,
QWidget#PlayerBar[compact="true"] QLabel#NowPlayingAlbum {
    font-size: 10px;
}

QLabel#MetaLabel,
QLabel#TimeLabel {
    color: {{color-text}};
    font-size: {{font-size-sm}};
    font-weight: 500;
}

QLabel#NowPlayingCover {
    background: {{color-bg-pressed}};
    border: 1px solid {{color-cover-border}};
    border-radius: 12px;
}

QSlider#PlayerSlider::groove:horizontal {
    height: 8px;
    background: {{color-bg-pressed}};
    border-radius: 4px;
    margin: 2px 0;
}

QSlider#PlayerSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: {{color-accent}};
    border: 2px solid {{color-slider-handle-border}};
}

QSlider#PlayerSlider::handle:horizontal:hover {
    background: {{color-accent-alt}};
}

QSlider#PlayerSlider::sub-page:horizontal {
    background: qlineargradient(
        x1:0, y1:0, x2:1, y2:0,
        stop:0 {{color-slider-fill-start}},
        stop:1 {{color-slider-fill-end}}
    );
    border-radius: 4px;
}

QSlider#PlayerSlider::add-page:horizontal {
    background: {{color-bg-pressed}};
    border-radius: 4px;
}

QComboBox#SpeedCombo {
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    padding: 6px 10px;
    color: {{color-text}};
    min-width: 88px;
    font-size: {{font-size-sm}};
}

QComboBox#SpeedCombo:hover {
    border-color: {{color-accent}};
}

QComboBox#SpeedCombo::drop-down {
    border: none;
    width: 18px;
}

QToolButton#SpeedAdjustButton {
    background: {{color-bg-control}};
    border: 1px solid {{color-border}};
    border-radius: {{radius-md}};
    min-width: 28px;
    min-height: 28px;
    font-size: 14px;
    font-weight: 600;
    padding: 2px;
}

QToolButton#SpeedAdjustButton:hover {
    border-color: {{color-accent}};
    background: {{color-bg-elevated}};
    color: {{color-accent}};
}
