QWidget#PlayerBar {
    background-color: #020617;
    border-top: 1px solid #111827;
}

QWidget#PlayerMeta,
QWidget#PlayerCenter,
QWidget#PlayerExtras {
    background: #040b19;
    border: 1px solid #111827;
    border-radius: 14px;
}

QToolButton {
    border: 1px solid transparent;
    background: transparent;
    padding: 8px;
    border-radius: 10px;
    color: #e5e7eb;
}

QToolButton:hover {
    background: #0b1222;
    border-color: #1f2937;
    color: #38bdf8;
}

QToolButton:pressed {
    background: #0f172a;
}

QToolButton#BtnPlay {
    background: #111827;
    border: 1px solid #1f2937;
    border-radius: 999px;
    padding: 10px;
    color: #e5e7eb;
}

QToolButton#BtnPlay:hover {
    border-color: #38bdf8;
    background: #08101f;
    color: #38bdf8;
}

QToolButton#BtnPlay:pressed {
    background: #0f172a;
}

QLabel {
    color: #9ca3af;
    font-size: 11px;
}

QLabel#NowPlaying {
    color: #f8fafc;
    font-size: 14px;
    font-weight: 600;
}

QLabel#NowPlayingArtist {
    color: #cbd5e1;
    font-size: 11px;
}

QLabel#NowPlayingAlbum {
    color: #64748b;
    font-size: 11px;
}

QLabel#MetaLabel,
QLabel#TimeLabel {
    color: #cbd5e1;
    font-size: 11px;
    font-weight: 500;
}

QLabel#NowPlayingCover {
    background: #0f172a;
    border: 1px solid #1e293b;
    border-radius: 12px;
}

QSlider#PlayerSlider::groove:horizontal {
    height: 8px;
    background: #0f172a;
    border-radius: 4px;
}

QSlider#PlayerSlider::handle:horizontal {
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
    background: #38bdf8;
    border: 2px solid #e0f2fe;
}

QSlider#PlayerSlider::handle:horizontal:hover {
    background: #7dd3fc;
}

QSlider#PlayerSlider::sub-page:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 #38bdf8, stop:1 #0ea5e9);
    border-radius: 4px;
}

QSlider#PlayerSlider::add-page:horizontal {
    background: #0f172a;
    border-radius: 4px;
}

QComboBox#SpeedCombo {
    background: #0b1222;
    border: 1px solid #1f2937;
    border-radius: 10px;
    padding: 8px 10px;
    color: #e5e7eb;
    min-width: 84px;
    font-size: 11px;
}

QComboBox#SpeedCombo:hover {
    border-color: #38bdf8;
}

QComboBox#SpeedCombo::drop-down {
    border: none;
    width: 18px;
}
