{%- set previous = ctx.read_file("CHANGELOG.md") -%}
{%- for version_obj, release in ctx.history.released.items() -%}
{%- if loop.first -%}
{%- set heading = "## " ~ version_obj.as_tag() ~ " (" ~ release.tagged_date.strftime("%Y-%m-%d") ~ ")" -%}
{%- if heading in previous -%}
{{ previous }}
{%- else -%}
{{ previous.replace("## Unreleased", "## Unreleased\n\n" ~ heading, 1) }}
{%- endif -%}
{%- endif -%}
{%- else -%}
{{ previous }}
{%- endfor -%}
